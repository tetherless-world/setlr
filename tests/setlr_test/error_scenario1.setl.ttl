@prefix prov:          <http://www.w3.org/ns/prov#> .
@prefix dcterms:       <http://purl.org/dc/terms/> .
@prefix void:          <http://rdfs.org/ns/void#> .
@prefix setl:          <http://purl.org/twc/vocab/setl/> .
@prefix csvw:          <http://www.w3.org/ns/csvw#> .
@prefix pv:            <http://purl.org/net/provenance/ns#> .
@prefix :              <http://example.com/setl/> .

# Test Case 1: Nested attribute access on None value
:table1 a csvw:Table, setl:Table;
  csvw:delimiter ",";
  prov:wasGeneratedBy [
    a setl:Extract;
    prov:used <error_scenario1.csv>;
  ].

<http://example.com/test1> a void:Dataset;
  prov:wasGeneratedBy [
    a setl:Transform, setl:JSLDT;
    prov:used :table1;
    prov:value '''[{
  "@id": "https://example.com/test1/{{row.ID}}",
  "name": "{{row.Name.strip().upper()}}",
  "type": "Person"
}]'''].

<test1.ttl> a pv:File;
    dcterms:format "text/turtle";
    prov:wasGeneratedBy [
      a setl:Load;
      prov:used <http://example.com/test1> ;
    ].
